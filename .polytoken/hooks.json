      "bash": "CODECUT_ROOT=\"${POLYTOKEN_PROJECT_DIR:-${POLYTOKEN_PROJECT_PATH:-$PWD}}\"; CODECUT_BIN=\"$CODECUT_ROOT/.codecut/runtime/codecut\"; [ -x \"$CODECUT_BIN\" ] || CODECUT_BIN=\"$CODECUT_BIN.exe\"; \"$CODECUT_BIN\" hook --agent polytoken"
